# Application Environment
PAYMENT_ENV=sandbox
RUN_SANDBOX_TESTS=true

# Zibal IPG Sandbox Configuration (Uses built-in test merchant "zibal")
ZIBAL_SANDBOX_MERCHANT=zibal
ZIBAL_SANDBOX_CALLBACK_URL=https://example.com/callback

# Mellat Sandbox Configuration (Requires custom test WSDL and portal URL provided by PSP)
MELLAT_SANDBOX_TERMINAL_ID=123456
MELLAT_SANDBOX_USERNAME=testuser
MELLAT_SANDBOX_PASSWORD=testpass
MELLAT_SANDBOX_CALLBACK_URL=https://example.com/callback
# MELLAT_SANDBOX_WSDL_URL=https://test-server.example.com/pgw?wsdl
# MELLAT_SANDBOX_PORTAL_URL=https://test-server.example.com/startpay

# Saman (SEP) Sandbox Configuration (Requires custom test endpoint URLs)
SAMAN_SANDBOX_TERMINAL_ID=12571198
SAMAN_SANDBOX_REDIRECT_URL=https://example.com/return
# SAMAN_SANDBOX_TOKEN_URL=https://test-sep.example.com/OnlinePG
# SAMAN_SANDBOX_VERIFY_URL=https://test-sep.example.com/Verify

# Zarinpal Sandbox Configuration (Requires custom test GraphQL URL)
ZARINPAL_SANDBOX_ACCESS_TOKEN=test_access_token
ZARINPAL_SANDBOX_CALLBACK_URL=https://example.com/callback
# ZARINPAL_SANDBOX_BASE_URL=https://test-api.example.com/v4/graphql
