    "clean": "rimraf dist",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@company/payment-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  },
  "keywords": [
