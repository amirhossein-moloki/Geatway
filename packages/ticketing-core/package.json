{
  "name": "@amirhossein-moloki/ticketing-core",
  "version": "1.0.0",
  "description": "Framework-agnostic core ticketing domain model, multi-tenant isolation, state machine, and service ports",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amirhossein-moloki/Geatway.git",
    "directory": "packages/ticketing-core"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@amirhossein-moloki/payment-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  },
  "keywords": [
    "ticketing",
    "ticketing-core",
    "multi-tenant",
    "support",
    "tickets",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
